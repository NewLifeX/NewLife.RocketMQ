<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyTitle>Enterprise RocketMQ Client</AssemblyTitle>
    <Description>Enterprise-grade fully managed RocketMQ client with dual-protocol support for Remoting 4.x/5.x and gRPC 5.x Proxy. Zero external dependencies: no Java, gRPC or Protobuf runtime required. Unified adapters for Alibaba Cloud, Huawei Cloud, Tencent Cloud and Apache ACL, with consume retry, dead-letter queue, transactional messages, ordered consumption and Pop consumption. Proven in billion-scale production systems.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 新生命开发团队</Copyright>
    <VersionPrefix>4.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <!-- 程序集版本固定为「主.次.0.0」：通配符版本与确定性构建（含基准测试框架生成的工程）冲突，且 .NET 亦推荐程序集版本只在发布时递增 -->
    <AssemblyVersion>$(VersionPrefix).0.0</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA2007</WarningsAsErrors>
    <!-- AOT/裁剪兼容分析仅对现代目标启用；上游 NewLife.Core 亦仅 net10.0 提供 IsAotCompatible 资产 -->
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
    <!-- Command 的成员图含 ReadOnlySequence（IPacket 相关），STJ 源生成器不支持该成员类型，仅影响 STJ 自身的生成代码，
         不影响 NewLife 源生成器为本库生成的成员访问器（MqJsonContext 的用途） -->
    <NoWarn Condition="'$(TargetFramework)' == 'net10.0'">$(NoWarn);SYSLIB1225</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageDescription>Enterprise-grade fully managed RocketMQ client with dual-protocol support for Remoting 4.x/5.x and gRPC 5.x Proxy. Zero external dependencies, unified cloud adapters, and complete enterprise features. 企业级纯托管 RocketMQ 客户端，双协议支持，零外部依赖，统一适配阿里云、华为云、腾讯云及 Apache ACL，完整企业级特性。</PackageDescription>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/core/rocketmq</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.RocketMQ</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;RocketMQ;纯托管;零依赖;Remoting;gRPC;阿里云;华为云;腾讯云;消息队列;MQ;分布式;事务消息;延迟消息;顺序消息;死信队列;事件总线;EventBus;MessageQueue;Queuing;Cloud;AOT;Localization;dotnet;csharp;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>主版本升级：依赖 NewLife.Core 12 核心网络库并适配其消息栈与运行时多语言，程序集版本提升到 4.0；新增事件总线 RocketMqEventBus&lt;T&gt; 与事件枢纽工厂，支持跨进程发布订阅；全部运行时消息改为英文源文并内置 31 种语言词表，按文化自动翻译；net10.0 开启 NativeAOT 兼容并新增 MqAot.RegisterBodyType 对象体登记 API；打通 RocketMQ 5.x gRPC Proxy 链路，覆盖消费重试、死信、事务、FIFO 与 ACL 2.0；修复大消息解压、解码失败导致队列假死与轨迹分发器泄漏；发布流程同时推送 NuGet.org 与 GitHub Packages，并依据 ChangeLog 自动创建 GitHub Release</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\ConsumeFromWheres.cs" />
    <Compile Remove="Protocol\SendStatus.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
  </ItemGroup>

</Project>
